# Copy to /opt/rag-chatbot/.env.production on the VPS; chmod 600.
# Never reuse local credentials. Use >=32 random hexadecimal characters for passwords.
COMPOSE_PROJECT_NAME=rag-chatbot-prod
POSTGRES_USER=rag
POSTGRES_DB=rag_chatbot
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
REDIS_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_HEX
SITE_ADDRESS=chat.example.com
WEB_ORIGIN=https://chat.example.com
ACME_EMAIL=ops@example.com
HTTP_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
# CI publishes immutable digest references. No latest tags.
API_IMAGE=ghcr.io/your-org/your-repo-api:REPLACE_WITH_COMMIT_SHA
WEB_IMAGE=ghcr.io/your-org/your-repo-web:REPLACE_WITH_COMMIT_SHA
# Backups must be on a private path with enough disk; copy encrypted off-host.
BACKUP_DIR=/opt/rag-chatbot/backups
